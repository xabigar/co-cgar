# Copia este archivo a .env y completa los valores antes de ejecutar npm start.
# .env permanece solo en el servidor. No lo compartas ni lo subas a Git.
PORT=3000
# openai | anthropic | deepseek | groq | gemini | compatible
SERVER_DEFAULT_PROVIDER=
SERVER_DEFAULT_MODEL=
SERVER_DEFAULT_API_KEY=s
# Al menos 12 caracteres. Se solicita al seleccionar Server default en la web.
SERVER_DEFAULT_PASSWORD=
# Solo para provider=compatible: URL completa de chat/completions.
SERVER_DEFAULT_ENDPOINT=
# Solo para desplegar tras un proxy (nginx): hosts públicos permitidos, separados por comas.
SERVER_ALLOWED_HOSTS=
# Solo en contenedores Docker: escucha interna (0.0.0.0). En local no es necesario.
HOST=
